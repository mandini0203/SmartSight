# Copy to .env and adjust. Every variable is optional; defaults shown.

SMARTSIGHT_ENVIRONMENT=development
SMARTSIGHT_LOG_LEVEL=INFO
# JSON list; only needed for browser clients (the Android app does not need CORS)
SMARTSIGHT_CORS_ORIGINS=[]

# Object detection (pretrained YOLOv8, COCO)
SMARTSIGHT_MODEL_PATH=models/yolov8n.pt
SMARTSIGHT_DETECTION_CONFIDENCE=0.35
SMARTSIGHT_DETECTION_IOU=0.45
SMARTSIGHT_DETECTION_IMAGE_SIZE=640
SMARTSIGHT_DETECTION_MAX_RESULTS=50
# "cpu", "0" (first CUDA GPU) or "mps"
SMARTSIGHT_INFERENCE_DEVICE=cpu
SMARTSIGHT_INFERENCE_TIMEOUT_SECONDS=20
SMARTSIGHT_WARMUP_ON_STARTUP=true

# Doors and exit signs: yolo_world | heuristic
SMARTSIGHT_DOOR_SIGN_BACKEND=yolo_world
SMARTSIGHT_DOOR_SIGN_MODEL_PATH=models/yolov8s-worldv2.pt
SMARTSIGHT_DOOR_SIGN_CONFIDENCE=0.15

# Personal-item matching: embedding | orb
SMARTSIGHT_ITEM_MATCHER=embedding
SMARTSIGHT_ITEM_MATCH_THRESHOLD=0.80
SMARTSIGHT_ITEM_POSSIBLE_MATCH_THRESHOLD=0.65
SMARTSIGHT_ITEM_MAX_REFERENCES=5

# Distance estimation (field of view across the long side of the photo)
SMARTSIGHT_DISTANCE_ESTIMATION_ENABLED=true
SMARTSIGHT_CAMERA_FOV_DEGREES=66

# Upload limits
SMARTSIGHT_MAX_UPLOAD_BYTES=8388608
SMARTSIGHT_MAX_IMAGE_SIDE=6000

# User accounts
# SQLite file in DATA_DIR unless DATABASE_URL is set (any SQLAlchemy URL)
# SMARTSIGHT_DATA_DIR=data          (default: backend/data)
SMARTSIGHT_DATABASE_URL=
# Required in production (32+ random characters). In development one is
# generated and saved to data/jwt_secret.
SMARTSIGHT_JWT_SECRET=
SMARTSIGHT_ACCESS_TOKEN_MINUTES=30
SMARTSIGHT_REFRESH_TOKEN_DAYS=30
# JSON list of Google OAuth *Web application* client IDs. Empty disables Google sign-in.
SMARTSIGHT_GOOGLE_CLIENT_IDS=[]
SMARTSIGHT_LOGIN_MAX_FAILURES=5
SMARTSIGHT_LOGIN_LOCKOUT_MINUTES=15
SMARTSIGHT_MAX_ITEMS_PER_USER=50
