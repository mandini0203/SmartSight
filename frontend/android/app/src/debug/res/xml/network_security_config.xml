<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY: allow plain HTTP so a phone can reach a development
  backend on the local network (e.g. http://192.168.1.20:8000).
  Release builds use src/main/res/xml/network_security_config.xml, which only
  allows cleartext to the emulator host.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true"/>
</network-security-config>
